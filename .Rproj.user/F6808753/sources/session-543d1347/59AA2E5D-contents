
sync <- function(message = paste("Update:", Sys.time())) {
  system("git add -A")
  system(sprintf('git commit -m "%s"', message))
  system("git push origin master")
  message("Git push complete!")
}

sync <- function(message = paste("Update:", format(Sys.time(), "%Y-%m-%d %H:%M:%S"))) {
  system("git add -A")
  system(sprintf('git commit -m "%s"', message))
  system("git push origin master")
  message("Git push complete!")
}

inspect_df <- function(df) {
  cat("--- Dataset Overview ---\n")
  cat("Dimensions:", nrow(df), "rows x", ncol(df), "columns\n")
  cat("Total NA values:", sum(is.na(df)), "\n\n")
  cat("--- Column Breakdown ---\n")
  summary_info <- data.frame(
    Column = names(df),
    Type = sapply(df, function(x) class(x)[1]),
    Missing = sapply(df, function(x) sum(is.na(x))),
    Missing_Pct = paste0(round(sapply(df, function(x) mean(is.na(x))) * 100, 1), "%"),
    Unique = sapply(df, function(x) length(unique(x))),
    row.names = NULL
  )
  print(summary_info)
}

.First <- function() {
  # Check if Git Bash / auto_push exists and start if not already active
  if (file.exists("auto_push.sh") && Sys.info()["sysname"] == "Windows") {
    # Launch git bash silently in the background detached from the console
    system('powershell -WindowStyle Hidden -Command "Start-Process bash -ArgumentList \\"./auto_push.sh\\" -WindowStyle Hidden"', wait = FALSE)
    message("Auto-sync watcher loaded in background.")
  }
}


