#Imports Spreadsheet
orangedata <- read.csv("Data/Orange trees FA26 - Sheet1.csv")
#Opens Spreadsheet In New Tab
View(orangedata)
orangedata
orangedata2 <- orangedata[,-c(1,2,4,5,6,7)]
orangedata2
#Calculates Mean then Standard Deviation of Circumference for Orange Trees
meancir <- mean(orangedata2$Circumference..cm.)
meansd <- sd(orangedata2$Circumference..cm.)
n <- sum(!is.na(orangedata2$Circumference..cm.))
SEMmeancir <- sd(orangedata2$Circumference..cm.)/sqrt(count(orangedata2)) #Standard Error of the Mean: SE = s/sqrt(n), where s = sample standard deviation and n = sample size
#find the critical value of t with n-1 df
t_critical <- qt(0.975, df = n - 1) #: better & reusable way to find critical t value for 95% confidence interval
qt(p = 0.025, df = 131, lower.tail = FALSE)
lowerCL <- meancir-(SEMmeancir*1.978239) #This calculates:[lower limit = ybar - t*SE]
lowerCL
upperCL <- meancir+(SEMmeancir*1.978239) #This calculates:[upper limit = ybar + t*SE]
upperCL
#Compare quantiles of the data to the quantiles of a normal distribution
qqnorm(orangedata2$Circumference..cm.)
qqline(orangedata2$Circumference..cm., col = "red", lwd = 2)
qqPlot(orangedata2$Circumference..cm., distribution = "norm", envelope = 0.95, main = "Normal Q-Q Plot of Tree Circumference")
